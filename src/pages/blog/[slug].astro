---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaButton from '../../components/CtaButton.astro';
import { site, whatsappUrl } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}`}
  ogType="article"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: { '@type': 'Organization', name: site.name },
    publisher: {
      '@type': 'Organization',
      name: site.name,
      logo: { '@type': 'ImageObject', url: `${site.url}/logo.svg` },
    },
    mainEntityOfPage: `${site.url}/blog/${post.id}`,
  }}
>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <Breadcrumbs
      items={[
        { name: 'Blog', href: '/blog' },
        { name: post.data.title, href: `/blog/${post.id}` },
      ]}
    />
    <time class="label-caps" datetime={post.data.pubDate.toISOString()}>
      {post.data.pubDate.toLocaleDateString('fr-MA', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
    <h1 class="mt-3 text-4xl font-bold sm:text-5xl">{post.data.title}</h1>
    <p class="mt-4 text-lg text-muted">{post.data.description}</p>

    <div
      class="mt-10 space-y-4 text-muted [&_a]:font-semibold [&_a]:text-primary [&_a]:underline-offset-2 hover:[&_a]:underline [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-text [&_li]:ml-5 [&_li]:list-disc [&_ol]:space-y-2 [&_p]:leading-relaxed [&_strong]:text-text [&_ul]:space-y-2"
    >
      <Content />
    </div>

    <div class="relative mt-14 overflow-hidden rounded-[var(--radius-md)] border border-line bg-soft p-7 text-center">
      <div class="dither-soft absolute inset-0 opacity-40" aria-hidden="true"></div>
      <div class="relative">
        <p class="font-display text-xl font-semibold text-text">Un projet en tête ?</p>
        <div class="mt-5">
          <CtaButton href={whatsappUrl()} label="Parler à DevStudio" />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
