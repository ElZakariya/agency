---
import { cities } from '../data/site';

interface Props {
  /** Optional keyword prefix for anchor text, e.g. "Site web" → "Site web à Dakhla" */
  anchorPrefix?: string;
  heading?: string;
  class?: string;
}

const {
  anchorPrefix = 'Agence web',
  heading = 'Interventions dans les villes du Maroc',
  class: className = '',
} = Astro.props;

const sorted = [...cities].sort((a, b) => a.priority - b.priority || a.name.localeCompare(b.name));
---

<section class:list={['mt-12', className]}>
  <h2 class="text-2xl font-bold">{heading}</h2>
  <p class="mt-3 text-sm text-muted">
    Pages locales pour le référencement et les clients dans chaque ville — DevStudio reste joignable partout au Maroc.
  </p>
  <ul class="mt-5 grid gap-2 sm:grid-cols-2">
    {
      sorted.map((city) => (
        <li>
          <a
            href={`/villes/${city.slug}`}
            class="block rounded-[var(--radius-sm)] border border-line bg-soft px-4 py-3 text-sm font-medium text-text hover:border-primary hover:text-primary"
          >
            {anchorPrefix} à {city.name}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-4">
    <a href="/villes" class="text-sm font-semibold text-primary hover:underline">
      Toutes les villes couvertes →
    </a>
  </p>
</section>
