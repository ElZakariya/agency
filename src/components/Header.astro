---
import { site, whatsappUrl } from '../data/site';
const pathname = Astro.url.pathname;
const links = [
  { href: '/services', label: 'Services' },
  { href: '/blog', label: 'Blog' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="nav-reveal sticky top-0 z-50 border-b border-line bg-surface/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${site.name} — Accueil`}>
      <img
        src="/logo.svg"
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 rounded-[var(--radius-sm)]"
        decoding="async"
      />
      <span class="font-display text-lg font-bold tracking-tight text-text group-hover:text-primary">
        {site.name}
      </span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Navigation principale">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium text-muted hover:text-primary',
              pathname.startsWith(link.href) && 'text-primary',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={whatsappUrl()}
        class="btn-primary px-3.5 py-2 text-sm"
        target="_blank"
        rel="noopener noreferrer"
      >
        Devis WhatsApp
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-[var(--radius-sm)] border border-line text-text md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Ouvrir le menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-surface md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3" aria-label="Navigation mobile">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="min-h-11 rounded-[var(--radius-sm)] px-3 py-2.5 text-sm font-medium text-text hover:bg-soft hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
