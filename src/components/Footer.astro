---
import { site, services, cities, whatsappUrl } from '../data/site';

const priorityCities = cities.filter((c) => c.priority <= 2);
const otherCities = cities.filter((c) => c.priority > 2);
---

<footer class="relative mt-8 overflow-hidden border-t border-line bg-text text-white">
  <div class="dither-soft absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <div>
      <a href="/" class="inline-flex items-center gap-2.5">
        <img src="/logo.svg" alt="" width="32" height="32" class="h-8 w-8 rounded-[var(--radius-sm)]" decoding="async" />
        <span class="font-display text-lg font-bold">{site.name}</span>
      </a>
      <p class="mt-4 text-sm leading-relaxed text-white/70">{site.tagline}</p>
      <a
        href={site.instagram}
        class="mt-4 inline-block text-sm text-white/80 underline-offset-4 hover:text-white hover:underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram @devstudio.ma
      </a>
    </div>

    <div>
      <h2 class="label-caps text-white/50">Services</h2>
      <ul class="mt-4 space-y-2">
        {
          services.map((s) => (
            <li>
              <a href={s.href} class="text-sm text-white/80 hover:text-white">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="label-caps text-white/50">Agence</h2>
      <ul class="mt-4 space-y-2">
        <li>
          <a href="/a-propos" class="text-sm text-white/80 hover:text-white">À propos</a>
        </li>
        <li>
          <a href="/blog" class="text-sm text-white/80 hover:text-white">Blog</a>
        </li>
        <li>
          <a href="/contact" class="text-sm text-white/80 hover:text-white">Contact</a>
        </li>
        <li>
          <a href="/villes" class="text-sm text-white/80 hover:text-white">Villes au Maroc</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="label-caps text-white/50">Contact</h2>
      <ul class="mt-4 space-y-2 text-sm text-white/80">
        <li>
          <a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a>
        </li>
        <li>
          <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="hover:text-white">{site.phoneDisplay}</a>
        </li>
        <li>
          <a href={whatsappUrl()} class="hover:text-white" target="_blank" rel="noopener noreferrer">
            WhatsApp
          </a>
        </li>
        <li class="pt-1 text-white/60">
          {site.address.streetAddress}<br />
          {site.address.addressLocality}, Maroc
        </li>
      </ul>
    </div>
  </div>

  {/* Soft local SEO crawl path — kept out of the homepage hero */}
  <div class="relative border-t border-white/10">
    <div class="mx-auto max-w-6xl px-4 py-5 sm:px-6">
      <p class="label-caps text-white/40">Zones desservies</p>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
        {
          priorityCities.map((c) => (
            <li>
              <a href={`/villes/${c.slug}`} class="text-xs text-white/65 hover:text-white">
                {c.name}
              </a>
            </li>
          ))
        }
        {
          otherCities.map((c) => (
            <li>
              <a href={`/villes/${c.slug}`} class="text-xs text-white/55 hover:text-white">
                {c.name}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/villes" class="text-xs font-semibold text-white/80 hover:text-white">
            Toutes les villes →
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>© {new Date().getFullYear()} {site.name}. Tous droits réservés.</p>
      <p>Agence web au Maroc</p>
    </div>
  </div>
</footer>
