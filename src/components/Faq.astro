---
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-line overflow-hidden rounded-[var(--radius-md)] border border-line bg-surface">
  {
    items.map((item) => (
      <details class="group px-5 py-4">
        <summary class="cursor-pointer list-none font-display text-base font-semibold text-text marker:content-none [&::-webkit-details-marker]:hidden">
          <span class="flex items-start justify-between gap-4">
            {item.question}
            <span class="mt-0.5 text-primary transition group-open:rotate-45">+</span>
          </span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-muted">{item.answer}</p>
      </details>
    ))
  }
</div>
